# Copy to .env.local and fill in your own values.
# None of these should ever be committed.

# Postgres connection string (Neon serverless Postgres or any Postgres).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Base URL the frontend uses to reach the API (your deployment URL in prod).
NEXT_PUBLIC_API_URL=http://localhost:3000

# Yahoo Fantasy integration (optional — flags rostered vs waiver-wire players).
# Create an app at https://developer.yahoo.com/apps/ to get credentials, then
# complete the OAuth flow once to obtain a refresh token.
YAHOO_CLIENT_ID=your-yahoo-client-id
YAHOO_CLIENT_SECRET=your-yahoo-client-secret
YAHOO_REFRESH_TOKEN=your-yahoo-refresh-token
# Your league key: {game_key}.l.{league_id} — find the league id in your
# league's URL on fantasy.yahoo.com.
YAHOO_LEAGUE_KEY=431.l.000000
# The redirect URI registered with your Yahoo app.
YAHOO_REDIRECT_URI=https://your-deployment.example.com/api/auth/yahoo/callback
